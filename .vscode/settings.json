{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode", // Ensure Prettier is used
  "prettier.enable": true, // Ensure Prettier runs
  "prettier.configPath": ".prettierrc",
  "eslint.lintTask.enable": false, // Prevent unnecessary background linting
  "editor.formatOnSave": true,
  "i18n-ally.localesPaths": [
    "locales"
  ] // Use your Prettier config
}
